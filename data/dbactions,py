from abc import ABC, abstractmethod

class Append(ABC):
    @abstractmethod
    def insert(self) -> int | None:        
        pass

class Insert(ABC):
    @abstractmethod
    def insert(self) -> int | None:
        pass
    
class AppendWord(Append):
    def insert(self):
        pass
    
class AppendSentence(Append):
    def insert(self):
        pass
        
class AppendWordSentenceLink(Append):
    def insert(self):
        pass
    
class InsertHanzi(Insert):
    def insert(self):
        pass
    
class InsertPinyin(Insert):
    def insert(self):
        pass
    
class AppendContext:
    def __init__(self, strategy: Append):
        self.strategy = strategy
    